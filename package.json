{
  "name": "mini-pi",
  "version": "0.1.0",
  "description": "A 600-line mini TypeScript project to build your own pi-agent from scratch.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "agent-loop",
    "llm",
    "tool-calling",
    "typescript",
    "pi-agent",
    "llm-agent"
  ],
  "type": "module",
  "bin": { "minipi": "./dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/js-yaml": "^4.0.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
